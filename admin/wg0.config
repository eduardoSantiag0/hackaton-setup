# admin/wg0.config
#
# Config do SERVIDOR WireGuard. Montado em /config/wg_confs/wg0.conf pelo
# docker-compose.yaml. Quando esse arquivo existe, a imagem linuxserver usa
# ele direto e nao gera peers/chaves por conta propria.
#
# GERADO/ATUALIZADO por admin/provisionar-grupos.sh -- rode o script em vez
# de editar a secao de PEERS a mao (o script e idempotente: rodar de novo
# nao duplica grupo ja provisionado).
#
# COMO PREENCHER NA PRIMEIRA VEZ:
#   Rode admin/provisionar-grupos.sh <IP_PUBLICO_DA_VM> <NUMERO_DE_GRUPOS>
#   Ele gera a chave do servidor (se ainda nao existir), preenche PrivateKey
#   abaixo e cria um [Peer] por grupo.
#
# Troque "eth0" abaixo se a interface de rede publica da VM tiver outro
# nome (confira com `ip route` na VM).

[Interface]
Address = 10.13.13.1/24
ListenPort = 51820
PrivateKey = <PREENCHER_PRIVKEY_DO_SERVIDOR>
PostUp = iptables -A FORWARD -i %i -j ACCEPT; iptables -t nat -A POSTROUTING -o eth0 -j MASQUERADE
PostDown = iptables -D FORWARD -i %i -j ACCEPT; iptables -t nat -D POSTROUTING -o eth0 -j MASQUERADE

# >>> PEERS GERADOS POR provisionar-grupos.sh (nao editar a mao abaixo desta linha) <<<
